// Lupus backend ERD (DBML) - generated from server/src/db/*.sql in db:migrate order
// Paste into https://dbdiagram.io

Table admin_layout {
  user_id text
  view_id text
  layout jsonb [not null, default: `'{}'`]
  updated_at timestamptz [not null, default: `NOW()`]

  indexes {
    (user_id, view_id) [pk]
  }
}

