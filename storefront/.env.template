# Backend the storefront talks to. Leave empty for same-origin (the Vite dev proxy forwards to :9001).
VITE_API_URL=
# Optional for a fresh local database. For multi-store scoping, copy the active Web Store key from Admin.
VITE_PUBLISHABLE_KEY=
# Default country code used by / redirect and the CountryGate.
VITE_DEFAULT_REGION=vn
