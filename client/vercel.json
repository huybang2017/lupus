{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && rm -rf out && mkdir -p out/app && cp -r dist/. out/app/",
  "outputDirectory": "out",
  "redirects": [{ "source": "/", "destination": "/app/", "permanent": false }],
  "rewrites": [
    { "source": "/:p(store|auth|admin|hooks|uploads|health)/:path*", "destination": "https://lupus-api-hsgo.onrender.com/:p/:path*" },
    { "source": "/:p(store|auth|admin|hooks|uploads|health)", "destination": "https://lupus-api-hsgo.onrender.com/:p" },
    { "source": "/app/:path*", "destination": "/app/index.html" }
  ]
}
